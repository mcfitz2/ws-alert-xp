# Classic Bluetooth only (saves RAM; the headset link is BR/EDR, no BLE used).
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Bluedroid host with Classic + HFP Audio Gateway.
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=n

# SCO audio over HCI. Phase A does not bridge audio; it only needs the SCO
# link to come up (that is the gate that puts the headset into radio mode).
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
# Wide-band (mSBC) off: force the simpler CVSD codec (codec id 1), matching the
# laptop test that put the WS6 into radio mode.
CONFIG_BT_HFP_WBS_ENABLE=n

# Secure Simple Pairing, auto-accepted in firmware.
CONFIG_BT_SSP_ENABLED=y

# A little more log headroom for bring-up.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
