diff --git a/platform/embedded/hci_dump_embedded_stdout.c b/platform/embedded/hci_dump_embedded_stdout.c
index c8160d7..3c5b2ac 100644
--- a/platform/embedded/hci_dump_embedded_stdout.c
+++ b/platform/embedded/hci_dump_embedded_stdout.c
@@ -124,6 +124,14 @@ static void hci_dump_embedded_stdout_packet(uint8_t packet_type, uint8_t in, uin
 }
 
 static void hci_dump_embedded_stdout_log_packet(uint8_t packet_type, uint8_t in, uint8_t *packet, uint16_t len) {
+    // WS6-PTT: skip SCO packets AND Number-Of-Completed-Packets events. With SCO
+    // audio flowing, each outbound silence packet (~250/s) produces one NOCP
+    // event (0x13); dumping those over the 115200 UART starves the run loop so
+    // we miss SCO TX deadlines and the link dies with reason 0x08 (supervision
+    // timeout). We only want the ACL/RFCOMM (AT command) exchange here.
+    if (packet_type == HCI_SCO_DATA_PACKET) return;
+    if (packet_type == HCI_EVENT_PACKET && len >= 1 &&
+        packet[0] == HCI_EVENT_NUMBER_OF_COMPLETED_PACKETS) return;
     hci_dump_embedded_stdout_timestamp();
     hci_dump_embedded_stdout_packet(packet_type, in, packet, len);
 }
