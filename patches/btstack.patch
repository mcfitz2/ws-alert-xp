+    if(COMMAND idf_build_set_property)
+        idf_build_set_property(BTSTACK_ROOT "${BTSTACK_ROOT}")
+    endif()
 endif()
 
 list(APPEND EXTRA_COMPONENT_DIRS "${BTSTACK_ROOT}/port/esp32/components/")
