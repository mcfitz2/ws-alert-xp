diff --git a/port/esp32/components/btstack/Kconfig b/port/esp32/components/btstack/Kconfig
index a7add23..a19a6a1 100644
--- a/port/esp32/components/btstack/Kconfig
+++ b/port/esp32/components/btstack/Kconfig
@@ -7,7 +7,9 @@ config BTSTACK_AUDIO
         Select this option to enable BTstack's audio driver
 
 config BTSTACK_INTERNAL_BT
-    visible if BT_CONTROLLER_ONLY
+    # 'visible if' is only valid on a menu/menuconfig; PlatformIO's kconfiglib
+    # rejects it on a plain config. The 'default y if BT_CONTROLLER_ONLY' below
+    # already enables this exactly when we need it.
     bool "Support for SoC Bluetooth"
     default y if BT_CONTROLLER_ONLY
     default n
diff --git a/port/esp32/components/btstack/cmake/BTstack_project.cmake b/port/esp32/components/btstack/cmake/BTstack_project.cmake
index 795d234..a3034ee 100644
--- a/port/esp32/components/btstack/cmake/BTstack_project.cmake
+++ b/port/esp32/components/btstack/cmake/BTstack_project.cmake
@@ -1,11 +1,18 @@
-idf_build_get_property(BTSTACK_ROOT BTSTACK_ROOT)
+# idf_build_get/set_property are undefined during PlatformIO's requirements
+# scan (component CMake runs in cmake -P script mode there). Guard them so the
+# env-var fallback still resolves BTSTACK_ROOT in that phase.
+if(COMMAND idf_build_get_property)
+    idf_build_get_property(BTSTACK_ROOT BTSTACK_ROOT)
+endif()
 if( NOT DEFINED BTSTACK_ROOT )
     if( NOT DEFINED ENV{BTSTACK_ROOT} )
         set(BTSTACK_ROOT ${CMAKE_SOURCE_DIR}/../..)
     else()
         set(BTSTACK_ROOT $ENV{BTSTACK_ROOT})
     endif()
-    idf_build_set_property(BTSTACK_ROOT "${BTSTACK_ROOT}")
+    if(COMMAND idf_build_set_property)
+        idf_build_set_property(BTSTACK_ROOT "${BTSTACK_ROOT}")
+    endif()
 endif()
 
 list(APPEND EXTRA_COMPONENT_DIRS "${BTSTACK_ROOT}/port/esp32/components/")
diff --git a/port/esp32/components/btstack/hci_transport_esp32_vhci.c b/port/esp32/components/btstack/hci_transport_esp32_vhci.c
index 1384129..2dbdc2a 100644
--- a/port/esp32/components/btstack/hci_transport_esp32_vhci.c
+++ b/port/esp32/components/btstack/hci_transport_esp32_vhci.c
@@ -144,7 +144,10 @@ static int host_recv_pkt_cb(uint8_t *data, uint16_t len){
     uint16_t space = btstack_ring_buffer_bytes_free(&hci_ringbuffer);
     if (space < len){
         xSemaphoreGive(ring_buffer_mutex);
-        log_error("transport_recv_pkt_cb packet %u, space %u -> dropping packet", len, space);
+        // Silent drop. Logging here prints over the slow UART from the VHCI
+        // callback path, which stalls the run loop and causes *more* drops - a
+        // feedback loop that destabilises SCO and buries ACL (CTKST) events.
+        // Dropping an inbound SCO (mic) packet is harmless for PTT.
         return 0;
     }
 
diff --git a/port/esp32/components/btstack_config/include/btstack_config.h b/port/esp32/components/btstack_config/include/btstack_config.h
index 7a89cc8..4b2e97d 100644
--- a/port/esp32/components/btstack_config/include/btstack_config.h
+++ b/port/esp32/components/btstack_config/include/btstack_config.h
@@ -25,7 +25,11 @@
 
 // BTstack features that can be enabled
 #define ENABLE_LOG_ERROR
-#define ENABLE_LOG_INFO
+// ENABLE_LOG_INFO disabled: with SCO audio flowing, btstack log_info prints
+// over the 115200 serial line for every inbound SCO packet, starving the run
+// loop so SCO/ACL RX buffers overflow ("dropping packet") and button CTKST
+// events get lost. App-level printf() (the [ptt] lines) is unaffected.
+// #define ENABLE_LOG_INFO
 #define ENABLE_PRINTF_HEXDUMP
 #define ENABLE_MODPLAYER
 
